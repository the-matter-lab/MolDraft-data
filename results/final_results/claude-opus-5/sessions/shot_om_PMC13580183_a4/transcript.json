     "command": "cat << 'EOF' > build4.py\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nimport numpy as np\n\n# cymene\ncy = Chem.AddHs(Chem.MolFromSmiles('CC(C)c1ccc(C)cc1'))\nAllChem.EmbedMolecule(cy, randomSeed=7)\nAllChem.MMFFOptimizeMolecule(cy)\ncpos = cy.GetConformer().GetPositions()\ncsyms = [a.GetSymbol() for a in cy.GetAtoms()]\nring = cy.GetSubstructMatch(Chem.MolFromSmarts('c1ccccc1'))\nprint('ring', ring)\ncent = cpos[list(ring)].mean(axis=0)\n# ring normal\nA = cpos[list(ring)]-cent\nu,s,vt = np.linalg.svd(A)\nnormal = vt[2]\n\n# part1\nlines = open('part1.xyz').read().split('\\n')\nn1 = int(lines[0])\nsyms1=[];pos1=[]\nfor l in lines[2:2+n1]:\n    p=l.split(); syms1.append(p[0]); pos1.append([float(x) for x in p[1:4]])\npos1=np.array(pos1)\nRu=24; Nim=2; Nnap=14; P=15\ndirs = []\nfor i in (Nim,Nnap,P):\n    v = pos1[i]-pos1[Ru]; dirs.append(v/np.linalg.norm(v))\nd = -np.sum(dirs,axis=0); d/=np.linalg.norm(d)\n\n# rotate cymene so that normal -> -d (centroid at Ru + 1.75*d, ring plane perpendicular to d)\ndef rotmat(a,b):\n    a=a/np.linalg.norm(a); b=b/np.linalg.norm(b)\n    v=np.cross(a,b); c=np.dot(a,b)\n    if np.linalg.norm(v)<1e-8:\n        return np.eye(3) if c>0 else -np.eye(3)\n    vx=np.array([[0,-v[2],v[1]],[v[2],0,-v[0]],[-v[1],v[0],0]])\n    return np.eye(3)+vx+vx@vx*(1/(1+c))\nR = rotmat(normal, -d)\ncpos2 = (cpos-cent)@R.T + pos1[Ru] + 1.78*d\n\nsyms = syms1 + csyms\npos = np.vstack([pos1, cpos2])\nwith open('init.xyz','w') as f:\n    f.write(f\"{len(syms)}\\ncomplex init\\n\")\n    for s,p in zip(syms,pos):\n        f.write(f\"{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\nprint(len(syms))\nring_global=[n1+i for i in ring]\nprint('ring global', ring_global)\nEOF\npython3 build4.py"
