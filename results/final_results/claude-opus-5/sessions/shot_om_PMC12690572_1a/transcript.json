    "name": "bash_kernel",
    "args": {
     "command": "cd /tmp && python << 'EOF'\nimport numpy as np\nL=[l.split() for l in open('frag.xyz').read().strip().split('\\n')[2:]]\nsym=[a[0] for a in L]; X=np.array([[float(v) for v in a[1:]] for a in L])\nRh=X[29]; lig=[X[16],X[30],X[1]]\nd=np.zeros(3)\nfor p in lig:\n    v=p-Rh; d+=v/np.linalg.norm(v)\nd/=np.linalg.norm(d)\nn=-d  # direction of Cp*\n# build in-plane basis\ntmp=np.array([0,0,1.0])\nif abs(np.dot(tmp,n))>0.9: tmp=np.array([1.0,0,0])\ne1=np.cross(n,tmp); e1/=np.linalg.norm(e1)\ne2=np.cross(n,e1)\ncen=Rh+1.83*n\nRring=1.21; Rme=1.21+1.50\nnew=[]\nfor i in range(5):\n    th=2*np.pi*i/5\n    u=np.cos(th)*e1+np.sin(th)*e2\n    c=cen+Rring*u + 0.0*n\n    me=cen+Rme*u+0.25*n\n    new.append(('C',c)); new.append(('C',me))\n    # 3 H on methyl\n    # local frame: radial u, n, tangential t\n    t=np.cross(n,u)\n    dirs=[u*0.8+n*0.6, u*0.5-n*0.5+t*0.75, u*0.5-n*0.5-t*0.75]\n    for dd in dirs:\n        dd=dd/np.linalg.norm(dd)\n        new.append(('H',me+1.09*dd))\nsyms=sym+[a for a,_ in new]\ncoords=np.vstack([X]+[b.reshape(1,3) for _,b in new])\nwith open('raw_full.xyz','w') as f:\n    f.write(f\"{len(syms)}\\nCp*Rh complex\\n\")\n    for s,c in zip(syms,coords):\n        f.write(f\"{s} {c[0]:.4f} {c[1]:.4f} {c[2]:.4f}\\n\")\nprint(len(syms))\n# ring C indices\nring=[58+i*5 for i in range(5)]\nprint(ring)\nEOF\n"
    }
