  "tool_calls": [
   {
    "name": "bash_kernel",
    "args": {
     "command": "cat > build.py << 'EOF'\nimport numpy as np\n\ndef rotz(a):\n    c,s=np.cos(a),np.sin(a)\n    return np.array([[c,-s,0],[s,c,0],[0,0,1]])\n\natoms=[]\ndef add(e,p): atoms.append((e,np.array(p,dtype=float)))\n\nadd('V',[0,0,0])\nNam=np.array([0,0,2.30]); add('N',Nam)\n\ndef add_h_on_c(C, nb1, nb2):\n    # two H on sp3 carbon C with neighbors nb1, nb2\n    b1=(nb1-C); b1/=np.linalg.norm(b1)\n    b2=(nb2-C); b2/=np.linalg.norm(b2)\n    bis=-(b1+b2); bis/=np.linalg.norm(bis)\n    perp=np.cross(b1,b2); perp/=np.linalg.norm(perp)\n    ang=np.deg2rad(54)\n    h1=C+1.09*(np.cos(ang)*bis+np.sin(ang)*perp)\n    h2=C+1.09*(np.cos(ang)*bis-np.sin(ang)*perp)\n    return h1,h2\n\narm_local=dict(C1=[1.32,0.45,2.75], C2=[2.30,0.30,1.62], S=[2.32,0.0,-0.15])\nfor k in range(3):\n    R=rotz(np.deg2rad(120*k))\n    C1=R@np.array(arm_local['C1'])\n    C2=R@np.array(arm_local['C2'])\n    S =R@np.array(arm_local['S'])\n    add('C',C1); add('C',C2); add('S',S)\n    for h in add_h_on_c(C1,Nam,C2): add('H',h)\n    for h in add_h_on_c(C2,C1,S): add('H',h)\n\n# acetonitrile\nNn=np.array([0,0,-2.15]); Cn=np.array([0,0,-3.31]); Cm=np.array([0,0,-4.77])\nadd('N',Nn); add('C',Cn); add('C',Cm)\nfor i in range(3):\n    a=np.deg2rad(120*i)\n    d=np.array([np.cos(a)*np.sin(np.deg2rad(110)),np.sin(a)*np.sin(np.deg2rad(110)),-np.cos(np.deg2rad(110))])\n    add('H',Cm+1.09*(-np.array([d[0],d[1],-d[2]])*0+d*np.array([1,1,1])))\n# fix methyl H: direction away from Cn (i.e., -z component)\natoms=[a for a in atoms]\n# rebuild methyl H properly\natoms=atoms[:-3]\nfor i in range(3):\n    a=np.deg2rad(120*i)\n    th=np.deg2rad(110)  # angle from C->Cn direction (+z)\n    d=np.array([np.sin(th)*np.cos(a), np.sin(th)*np.sin(a), np.cos(th)])\n    add('H',Cm+1.09*d)\n\nwith open('init.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\nV(NS3)(NCCH3) initial\\n\")\n    for e,p in atoms:\n        f.write(f\"{e} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\nprint(len(atoms))\nEOF\npython3 build.py && cat init.xyz"
    }
