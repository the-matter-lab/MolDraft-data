     "command": "cat << 'EOF' > geo.py\nimport numpy as np\nL=open('opt1.xyz').read().split('\\n')\nn=int(L[0]); sy=[];xyz=[]\nfor l in L[2:2+n]:\n    p=l.split(); sy.append(p[0]); xyz.append([float(x) for x in p[1:4]])\nxyz=np.array(xyz)\ndef d(i,j): return np.linalg.norm(xyz[i]-xyz[j])\ndef ang(i,j,k):\n    a=xyz[i]-xyz[j]; b=xyz[k]-xyz[j]\n    return np.degrees(np.arccos(a@b/np.linalg.norm(a)/np.linalg.norm(b)))\nfor j in [0,2,3,37,38]:\n    print('Ir-',j,sy[j],round(d(1,j),3))\nimport itertools\nfor i,j in itertools.combinations([0,2,3,37,38],2):\n    print(i,j,round(ang(i,1,j),1))\nEOF\npython geo.py"
    }
