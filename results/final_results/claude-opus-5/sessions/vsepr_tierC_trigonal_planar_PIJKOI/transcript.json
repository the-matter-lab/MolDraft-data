    "name": "bash_kernel",
    "args": {
     "command": "cat << 'EOF' > build.py\nimport numpy as np\n\natoms=[]\ndef add(sym,x,y,z): atoms.append((sym,np.array([x,y,z],float)))\n\nPd=np.array([0,0,0.])\nadd('Pd',*Pd)\nC1=np.array([-1.54,1.43,0.]); C2=np.array([-1.54,-1.43,0.])\nC3=np.array([-3.02,1.19,0.]); C4=np.array([-3.02,-1.19,0.])\nO=np.array([-3.80,0.,0.])\nC1a=np.array([-1.155,2.703,0.]); C2a=np.array([-1.155,-2.703,0.])\nadd('C',*C1); add('C',*C2)\nadd('C',*C1a); add('C',*C2a)\nadd('C',*C3); add('C',*C4)\nadd('O',*O)\n# vinylidene H's\nfor c,(h1,h2) in [(C1a,((-0.094,2.952,0.),(-1.902,3.498,0.))),\n                  (C2a,((-0.094,-2.952,0.),(-1.902,-3.498,0.)))]:\n    add('H',*h1); add('H',*h2)\n# OCH2 hydrogens\nfor C,sgn in [(C3,1),(C4,-1)]:\n    v1=C1-C3 if sgn==1 else C2-C4\n    v1=v1/np.linalg.norm(v1)\n    v2=O-C; v2=v2/np.linalg.norm(v2)\n    b=-(v1+v2); b/=np.linalg.norm(b)\n    z=np.array([0,0,1.])\n    for s in (1,-1):\n        d=0.577*b+s*0.816*z\n        add('H',*(C+1.09*d/np.linalg.norm(d)))\n# PMe3\nP=np.array([2.30,0.,0.]); add('P',*P)\ndirs=[np.array([0.423,0.906,0.]),np.array([0.423,-0.453,0.785]),np.array([0.423,-0.453,-0.785])]\nfor d in dirs:\n    d=d/np.linalg.norm(d)\n    Cm=P+1.83*d\n    add('C',*Cm)\n    # build local frame\n    ref=np.array([0,0,1.]) if abs(d[2])<0.9 else np.array([0,1.,0.])\n    e1=np.cross(d,ref); e1/=np.linalg.norm(e1)\n    e2=np.cross(d,e1)\n    for k in range(3):\n        ang=2*np.pi*k/3\n        hd=0.333*d+0.943*(np.cos(ang)*e1+np.sin(ang)*e2)\n        hd/=np.linalg.norm(hd)\n        add('H',*(Cm+1.09*hd))\nwith open('start.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\nPd complex\\n\")\n    for s,p in atoms:\n        f.write(f\"{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\nprint(len(atoms))\nEOF\npython build.py && cat start.xyz"
