 {
  "type": "AIMessage",
  "content": "",
  "tool_calls": [
   {
    "name": "bash_kernel",
    "args": {
     "command": "cat << 'EOF' > build.py\nimport numpy as np\n\ndef unit(v): \n    v=np.array(v,float); return v/np.linalg.norm(v)\n\ndef place(a,b,c,r,theta,phi):\n    \"\"\"place atom D: distance r to a, angle theta D-a-b, dihedral phi D-a-b-c (deg)\"\"\"\n    a=np.array(a,float); b=np.array(b,float); c=np.array(c,float)\n    th=np.radians(theta); ph=np.radians(phi)\n    bc = unit(a-b)             # from b to a\n    n = np.cross(unit(b-c), bc)\n    if np.linalg.norm(n)<1e-6:\n        n = np.cross([0,0,1.],bc)\n    n = unit(n)\n    m = np.cross(n,bc)\n    d2 = np.array([-r*np.cos(th), r*np.sin(th)*np.cos(ph), r*np.sin(th)*np.sin(ph)])\n    return a + d2[0]*bc + d2[1]*m + d2[2]*n\n\ndef rot_align(a,b):\n    a=unit(a); b=unit(b)\n    v=np.cross(a,b); c=np.dot(a,b)\n    if np.linalg.norm(v)<1e-8:\n        if c>0: return np.eye(3)\n        # 180 deg\n        w = unit(np.cross(a,[1.,0,0]) if abs(a[0])<0.9 else np.cross(a,[0,1.,0]))\n        return -np.eye(3)+2*np.outer(w,w)\n    vx=np.array([[0,-v[2],v[1]],[v[2],0,-v[0]],[-v[1],v[0],0]])\n    return np.eye(3)+vx+vx@vx/(1+c)\n\ndef methyl_H(Pc, Rparent, atoms, rCH=1.09):\n    b = unit(Pc-Rparent)\n    # perp frame\n    t = np.array([1.,0,0])\n    if abs(np.dot(t,b))>0.9: t=np.array([0,1.,0])\n    e1=unit(np.cross(b,t)); e2=np.cross(b,e1)\n    th=np.radians(70.53)\n    for phi in (0,120,240):\n        p=np.radians(phi)\n        d = np.cos(th)*b + np.sin(th)*(np.cos(p)*e1+np.sin(p)*e2)\n        atoms.append(('H', Pc+rCH*d))\n\natoms=[]\nNi=np.array([0.,0.,0.])\natoms.append(('Ni',Ni))\n\n# ---- MeCN axial +z\nN1 = Ni+np.array([0,0,1.88])\nC1 = N1+np.array([0,0,1.16])\nC2 = C1+np.array([0,0,1.46])\natoms += [('N',N1),('C',C1),('C',C2)]\nmethyl_H(C2, C1, atoms)\n\n# ---- eta5 GaCp*\ndef add_GaCpstar(u, atoms, dNiGa=2.28, dGaCent=2.06, rring=1.215, dCMe=1.50, tilt=0.25):\n    u=unit(u)\n    Ga = Ni + dNiGa*u\n    cent = Ga + dGaCent*u\n    t=np.array([1.,0,0])\n    if abs(np.dot(t,u))>0.9: t=np.array([0,1.,0])\n    e1=unit(np.cross(u,t)); e2=np.cross(u,e1)\n    atoms.append(('Ga',Ga))\n    ring=[]\n    for k in range(5):\n        a=np.radians(72*k)\n        p = cent + rring*(np.cos(a)*e1+np.sin(a)*e2)\n        ring.append(p); atoms.append(('C',p))\n    for k in range(5):\n        a=np.radians(72*k)\n        radial = np.cos(a)*e1+np.sin(a)*e2\n        d = unit(radial + tilt*u)\n        p = ring[k] + dCMe*d\n        atoms.append(('C',p))\n        methyl_H(p, ring[k], atoms)\n\nadd_GaCpstar([0,0,-1],atoms)                   # axial down\nadd_GaCpstar([-0.5, 0.866,0],atoms)            # equatorial\nadd_GaCpstar([-0.5,-0.866,0],atoms)            # equatorial\n\n# ---- Ga-amide ligand, equatorial +x\nGa4 = Ni + 2.30*unit([1,0,0])\natoms.append(('Ga',Ga4))\nd = unit([np.cos(np.radians(50)),0,np.sin(np.radians(50))])\nN2 = Ga4 + 1.95*d\natoms.append(('N',N2))\nCam = place(N2,Ga4,Ni,1.38,125,180)\natoms.append(('C',Cam))\nHN  = place(N2,Ga4,Ni,1.02,118,0)\natoms.append(('H',HN))\nCv  = place(Cam,N2,Ga4,1.34,122,180)   # =CH2\natoms.append(('C',Cv))\natoms.append(('H',place(Cv,Cam,N2,1.08,121,0)))\natoms.append(('H',place(Cv,Cam,N2,1.08,121,180)))\nC1r = place(Cam,N2,Ga4,1.52,118,0)     # ring ipso carbon\n\n# ---- sigma-bonded C5Me5 at C1r\nrring=1.23\n# local frame: ring plane = xy, C1 at angle 90deg\nloc_ring=[]\nfor k in range(5):\n    a=np.radians(90+72*k)\n    loc_ring.append(np.array([rring*np.cos(a), rring*np.sin(a),0.]))\nloc=[]  # (elem, pos)\nsubst_local = unit(np.array([0,1.,0])*0.6 + np.array([0,0,1.])*0.8)  # from C1 outward + up\nme1_local   = unit(np.array([0,1.,0])*0.6 + np.array([0,0,-1.])*0.8)\nloc.append(('C',loc_ring[0]))\nfor k in range(1,5):\n    loc.append(('C',loc_ring[k]))\n# methyls\nloc.append(('C', loc_ring[0]+1.52*me1_local))\nfor k in range(1,5):\n    a=np.radians(90+72*k)\n    loc.append(('C', loc_ring[k]+1.50*np.array([np.cos(a),np.sin(a),0.])))\n# rotate: map subst_local -> desired direction (C1r -> Cam) ... we want C1->Cam\nwant = unit(Cam-C1r)\nR = rot_align(subst_local, want)\n# apply, translate C1 to C1r\nfrag=[]\nfor e,p in loc:\n    frag.append((e, R@(p-loc_ring[0]) + C1r))\n# add ring carbons & methyls, with H on methyls\npositions=[p for e,p in frag]\nfor i in range(5):\n    atoms.append(('C',positions[i]))\nfor i in range(5):\n    parent = positions[i]\n    mp = positions[5+i]\n    atoms.append(('C',mp))\n    methyl_H(mp,parent,atoms)\n\nwith open('init.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\ninitial guess\\n\")\n    for e,p in atoms:\n        f.write(f\"{e} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\nprint(len(atoms))\nfrom collections import Counter\nprint(Counter(e for e,p in atoms))\nEOF\npython3 build.py"
    }
   }
