     "command": "cat << 'EOF' > build.py\nimport numpy as np\n\n# local butadiene frame\nC1l=np.array([-1.472,1.187,0.0]); C2l=np.array([-0.73,0,0]); C3l=np.array([0.73,0,0]); C4l=np.array([1.472,1.187,0])\nCol=np.array([0.0,1.1965,1.4267])\n# H's local\nH1a=np.array([-0.960,2.150,-0.15])  # syn on C1\nH1b=np.array([-2.561,1.149,-0.35])  # anti on C1\nH4a=np.array([0.960,2.150,-0.15])\nH4b=np.array([2.561,1.149,-0.35])\nH2=np.array([-1.259,-0.953,-0.10])\nH3=np.array([1.259,-0.953,-0.10])\n\nEx=np.array([0.0,1.0,0.0]); Ey=np.array([-0.376,0.0,0.926]); Ez=np.array([0.926,0.0,0.376])\ndef g(p):\n    v=p-Col\n    return v[0]*Ex+v[1]*Ey+v[2]*Ez\n\natoms=[]\natoms.append(('Co',np.zeros(3)))\n# Cp\nzc=1.70; r=1.208\nfor i in range(5):\n    a=np.deg2rad(90+72*i)\n    c=np.array([r*np.cos(a),r*np.sin(a),zc])\n    atoms.append(('C',c))\nfor i in range(5):\n    a=np.deg2rad(90+72*i)\n    rh=r+1.08\n    h=np.array([rh*np.cos(a),rh*np.sin(a),zc+0.05])\n    atoms.append(('H',h))\n# butadiene\nfor p in [C1l,C2l,C3l,C4l]:\n    atoms.append(('C',g(p)))\nfor p in [H1a,H1b,H2,H3,H4a,H4b]:\n    atoms.append(('H',g(p)))\n# CO\nd=np.array([0.819,0.0,-0.574]); d/=np.linalg.norm(d)\nCc=1.76*d; Oo=Cc+1.15*d\natoms.append(('C',Cc)); atoms.append(('O',Oo))\n\nwith open('start.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\nCpCo(butadiene)(CO)\\n\")\n    for s,p in atoms:\n        f.write(f\"{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\n# report\nprint(len(atoms))\nfor i,(s,p) in enumerate(atoms):\n    print(i,s,np.round(p,3), round(np.linalg.norm(p),3))\nEOF\npython3 build.py"
