     "command": "cat << 'EOF' > build2.py\nimport numpy as np\natoms=[]\ndef add(s,p): atoms.append((s,np.array(p,float)))\ndef unit(v):\n    v=np.array(v,float); return v/np.linalg.norm(v)\nTi=np.zeros(3); add('Ti',Ti)\n# Cp* ligands along +-z, tilted to -x\nfor sgn in (1,-1):\n    nd=unit([-0.3665,0.0,sgn*0.9304])\n    cen=Ti+2.10*nd\n    a=unit(np.cross(nd,[0,1,0])); b=unit(np.cross(nd,a))\n    r=1.22\n    for j in range(5):\n        th=2*np.pi*j/5+ (0.3 if sgn>0 else 0.9)\n        c=cen+r*(np.cos(th)*a+np.sin(th)*b); add('C',c)\n        rad=unit(c-cen); mc=c+1.50*unit(rad+0.18*nd); add('C',mc)\n        ax=unit(mc-c); p1=unit(np.cross(ax,nd)); p2=unit(np.cross(ax,p1))\n        for k in range(3):\n            phi=2*np.pi*k/3+0.4\n            d=unit(ax*np.cos(np.radians(70.5))+(np.cos(phi)*p1+np.sin(phi)*p2)*np.sin(np.radians(70.5)))\n            add('H',mc+1.09*d)\nCu=np.array([2.70,0.,0.]); add('Cu',Cu); add('Br',Cu+np.array([2.32,0,0]))\nz=np.array([0.,0.,1.])\nfor sgn in (1,-1):\n    def dirn(deg): \n        a=np.radians(deg)*sgn; return np.array([np.cos(a),np.sin(a),0.])\n    Ca=Ti+2.10*dirn(48); Cb=Ca+1.24*dirn(30)\n    add('C',Ca); add('C',Cb)\n    u=dirn(45)\n    Cipso=Cb+1.43*u\n    n=unit(np.cross(u,z))   # normal in xy-plane -> ring plane contains z\n    v=unit(np.cross(n,u))   # in-plane perpendicular (= z-ish)\n    cen=Cipso+1.39*u\n    ring=[]\n    for j in range(6):\n        th=np.radians(60*j)\n        p=cen+1.39*(np.cos(th)*(-u)+np.sin(th)*v); ring.append(p); add('C',p)\n    for j in (2,3,4):\n        p=ring[j]; add('H',p+1.09*unit(p-cen))\n    for j in (1,5):\n        p=ring[j]; d=unit(p-cen); mc=p+1.51*d; add('C',mc)\n        p1=unit(np.cross(d,n)); p2=unit(np.cross(d,p1))\n        for k in range(3):\n            phi=2*np.pi*k/3+0.5\n            dd=unit(d*np.cos(np.radians(70.5))+(np.cos(phi)*p1+np.sin(phi)*p2)*np.sin(np.radians(70.5)))\n            add('H',mc+1.09*dd)\nwith open('init2.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\ninit2\\n\")\n    for s,p in atoms: f.write(f\"{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\n# min dist check\nimport itertools\nP=np.array([p for _,p in atoms]); S=[s for s,_ in atoms]\nm=[]\nfor i,j in itertools.combinations(range(len(P)),2):\n    d=np.linalg.norm(P[i]-P[j])\n    if d<1.0: m.append((i,S[i],j,S[j],round(d,2)))\nprint(len(atoms), m[:20])\nEOF\npython build2.py"
