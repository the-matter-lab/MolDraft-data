     "command": "cat << 'EOF' > build.py\nimport numpy as np\n\natoms=[]\ndef add(sym,pos): atoms.append((sym,np.array(pos,dtype=float)))\n\ndef unit(v):\n    v=np.array(v,float); return v/np.linalg.norm(v)\n\nTi=np.array([0.,0.,0.])\nadd('Ti',Ti)\n\n# ---- Cp* ligands : centroids in xz plane ----\nfor sgn in (1,-1):\n    nd=unit([-0.3665,0.0,sgn*0.9304])\n    cen=Ti+2.10*nd\n    # in-plane basis\n    a=unit(np.cross(nd,[0,1,0]))\n    b=unit(np.cross(nd,a))\n    r=1.22\n    for j in range(5):\n        th=2*np.pi*j/5\n        c=cen+r*(np.cos(th)*a+np.sin(th)*b)\n        add('C',c)\n        # methyl carbon : radially outward, slightly away from Ti\n        rad=unit(c-cen)\n        mc=c+1.50*unit(rad+0.15*nd)\n        add('C',mc)\n        # 3 H on methyl\n        ax=unit(mc-c)\n        p1=unit(np.cross(ax,nd)); p2=unit(np.cross(ax,p1))\n        for k in range(3):\n            phi=2*np.pi*k/3\n            d=unit(ax*np.cos(np.radians(70.5))+ (np.cos(phi)*p1+np.sin(phi)*p2)*np.sin(np.radians(70.5)))\n            add('H',mc+1.09*d)\n\n# ---- Cu, Br on +x axis ----\nCu=np.array([3.60,0.,0.])\nadd('Cu',Cu)\nadd('Br',Cu+np.array([2.30,0.,0.]))\n\n# ---- two alkynyl-aryl arms in xy plane ----\nfor sgn in (1,-1):\n    a1=np.radians(35.0)*sgn\n    Ca=Ti+2.10*np.array([np.cos(a1),np.sin(a1),0.])\n    d1=np.array([np.cos(np.radians(25.0)*sgn),np.sin(np.radians(25.0)*sgn),0.])\n    Cb=Ca+1.23*d1\n    add('C',Ca); add('C',Cb)\n    d2=np.array([np.cos(np.radians(35.0)*sgn),np.sin(np.radians(35.0)*sgn),0.])\n    Cipso=Cb+1.43*d2\n    u=unit(d2)\n    n=np.array([0.,0.,1.])\n    v=unit(np.cross(n,u))\n    cen=Cipso+1.39*u\n    ring=[]\n    for j in range(6):\n        th=np.radians(60*j)\n        p=cen+1.39*(np.cos(th)*(-u)+np.sin(th)*v)\n        ring.append(p); add('C',p)\n    # H on meta(2,4) and para(3)\n    for j in (2,3,4):\n        p=ring[j]; d=unit(p-cen)\n        add('H',p+1.09*d)\n    # methyls on ortho (1,5)\n    for j in (1,5):\n        p=ring[j]; d=unit(p-cen)\n        mc=p+1.51*d\n        add('C',mc)\n        ax=d\n        p1=unit(np.cross(ax,n)); p2=unit(np.cross(ax,p1))\n        for k in range(3):\n            phi=2*np.pi*k/3\n            dd=unit(ax*np.cos(np.radians(70.5))+(np.cos(phi)*p1+np.sin(phi)*p2)*np.sin(np.radians(70.5)))\n            add('H',mc+1.09*dd)\n\nwith open('init.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\nCp*2Ti(C2Ar)2CuBr initial\\n\")\n    for s,p in atoms:\n        f.write(f\"{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\nprint(len(atoms))\nfrom collections import Counter\nprint(Counter(s for s,_ in atoms))\nEOF\npython build.py"
