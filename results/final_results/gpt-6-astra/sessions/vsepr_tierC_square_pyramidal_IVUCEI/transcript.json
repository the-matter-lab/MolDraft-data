     "command": "python - <<'PY'\nimport numpy as np\nfrom rdkit import Chem\nx=np.loadtxt('run3/xtbopt.xyz',skiprows=2,usecols=(1,2,3));m=Chem.MolFromMolFile('initial.mol',removeHs=False)\nfor i in [1,2,3,19,38]:print('Ir-',i,np.linalg.norm(x[i]-x[0]))\nfor i,j in [(1,2),(19,38),(3,19),(3,38),(1,3),(1,19),(1,38)]:\n a=x[i]-x[0];b=x[j]-x[0];print('angle',i,j,np.degrees(np.arccos(np.clip(np.dot(a,b)/np.linalg.norm(a)/np.linalg.norm(b),-1,1))))\nfor b in m.GetBonds():\n i,j=b.GetBeginAtomIdx(),b.GetEndAtomIdx();d=np.linalg.norm(x[i]-x[j])\n if i>0 and j>0 and d>1.7:print('long bond',i,j,d)\nfor i in [1,2]:print('Cl nearest',i,sorted([(round(float(np.linalg.norm(x[i]-x[j])),3),j) for j in range(len(x)) if j!=i])[:8])\n# nonbonded distances below 1.7 heavy or 1.2 H\nfor i in range(len(x)):\n for j in range(i):\n  if m.GetBondBetweenAtoms(i,j):continue\n  d=np.linalg.norm(x[i]-x[j]);thresh=1.2 if 'H' in [m.GetAtomWithIdx(i).GetSymbol(),m.GetAtomWithIdx(j).GetSymbol()] else 1.7\n  if d<thresh:print('Clash',i,j,d)\nPY"
