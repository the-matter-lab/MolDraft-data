    "args": {
     "command": "cat > build.py <<'PY'\nimport numpy as np\nfrom math import sin, cos, pi\natoms=[]\ndef add(e,p):\n atoms.append((e,np.array(p,dtype=float)));return len(atoms)-1\nadd('Ti',[0,0,0]);add('Cu',[3.25,0,0]);add('Br',[5.59,0,0])\ncp_rings=[]\nfor sign,phase in [(1,pi/10),(-1,-pi/10)]:\n normal=np.array([-cos(65*pi/180),0,sign*sin(65*pi/180)])\n center=2.14*normal\n u=np.array([sin(65*pi/180),0,sign*cos(65*pi/180)])\n v=np.cross(normal,u)\n ring=[]\n dirs=[]\n for j in range(5):\n  theta=phase+2*pi*j/5\n  d=cos(theta)*u+sin(theta)*v\n  dirs.append(d);ring.append(add('C',center+(1.43/(2*sin(pi/5)))*d))\n cp_rings.append(ring)\n for j,d in enumerate(dirs):\n  r=atoms[ring[j]][1]; m=r+1.5*d\n  add('C',m)\n  q=np.cross(d,normal)\n  for k in range(3):\n   t=2*pi*k/3+j*pi/3\n   h=d/3+np.sqrt(8/9)*(cos(t)*normal+sin(t)*q)\n   add('H',m+1.09*h)\nlig=[]\nfor sign in [1,-1]:\n a=39.9*pi/180\n d=np.array([cos(a),sign*sin(a),0]);z=np.array([0.,0.,1.]);perp=np.cross(z,d)\n # phenyl plane tilted ~65 degrees away from the metal-acetylide plane\n w=cos(65*pi/180)*perp+sign*sin(65*pi/180)*z\n ca=add('C',2.10*d);cb=add('C',(2.10+1.24)*d)\n ipso=(2.10+1.24+1.43)*d;center=ipso+1.395*d\n phen=[]\n for j in range(6):\n  t=j*pi/3\n  r=-cos(t)*d+sin(t)*w\n  phen.append(add('C',center+1.395*r))\n for j in range(1,6):\n  r=atoms[phen[j]][1]-center\n  add('H',atoms[phen[j]][1]+1.085*r/np.linalg.norm(r))\n lig.append((ca,cb))\nwith open('initial.xyz','w') as f:\n f.write(f'{len(atoms)}\\nCp*2Ti(C#CPh)2.CuBr; constructed haptic coordination geometry\\n')\n for e,p in atoms:f.write(f'{e:2s} {p[0]: .8f} {p[1]: .8f} {p[2]: .8f}\\n')\nprint('Atoms',len(atoms),'Cp rings',cp_rings,'acetylides',lig)\nPY\npython build.py"
