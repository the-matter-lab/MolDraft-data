   {
    "name": "bash_kernel",
    "args": {
     "command": "cat > build.py <<'PY'\nimport numpy as np, json\nsymbols=[];pos=[];labels={};cons=[]\ndef atom(el,p,label):\n i=len(symbols);symbols.append(el);pos.append(np.array(p,dtype=float));labels[label]=i;return i\ndef bond(a,b,r):\n cons.append({'atoms':[labels[a],labels[b]],'value':r})\ndef unit(v):\n return v/np.linalg.norm(v)\ndef methyl(o,c,label):\n ci=atom('C',c,label);v=unit(pos[o]-c)\n e=np.cross(v,[0,1,0]);e=unit(e); f=np.cross(v,e)\n for j in range(3):\n  ang=2*np.pi*j/3+0.2\n  dire=-v/3+np.sqrt(8/9)*(e*np.cos(ang)+f*np.sin(ang))\n  atom('H',c+1.09*dire,label+'H'+str(j+1))\n return ci\natom('O',[0,0,0],'Oc')\natom('Mo',[0,0,-2.32],'Mo')\natom('Na',[0,0,3.23],'Na')\nfor k in range(4):\n phi=np.pi*k/2\n u=np.array([np.cos(phi),np.sin(phi),0])\n atom('W',2.32*u,f'W{k}')\n bond('Oc',f'W{k}',2.32)\n atom('O',4.02*u,f'Ot{k}');bond(f'W{k}',f'Ot{k}',1.70)\n # Na-side oxygen; terminal-like W-O bridge to Na\n atom('O',1.85*u+np.array([0,0,1.77]),f'On{k}')\n bond(f'W{k}',f'On{k}',1.83);bond('Na',f'On{k}',2.36)\n # Mo-side bridging alkoxide\n oi=atom('O',1.96*u+np.array([0,0,-1.96]),f'Om{k}')\n bond(f'W{k}',f'Om{k}',2.00);bond('Mo',f'Om{k}',2.00)\n c=pos[oi]+1.43*unit(u+np.array([0,0,-1]))\n methyl(oi,c,f'Cm{k}')\nfor k in range(4):\n a=np.pi*k/2;b=np.pi*(k+1)/2\n p=1.862*(np.array([np.cos(a),np.sin(a),0])+np.array([np.cos(b),np.sin(b),0]))\n atom('O',p,f'Ob{k}')\n bond(f'W{k}',f'Ob{k}',1.92);bond(f'W{(k+1)%4}',f'Ob{k}',1.92)\nbond('Mo','Oc',2.32)\natom('N',[0,0,-4.10],'N');bond('Mo','N',1.78)\natom('O',[0,0,-5.27],'Ono');bond('N','Ono',1.17)\noi=atom('O',[0,0,5.59],'Omeoh');bond('Na','Omeoh',2.36)\nmethyl(oi,pos[oi]+1.43*np.array([np.sqrt(8/9),0,1/3]),'Cmeoh')\natom('H',pos[oi]+0.97*np.array([-np.sqrt(2/9),np.sqrt(2/3),1/3]),'Hoh')\nwith open('initial.xyz','w') as f:\n f.write(f'{len(symbols)}\\n[Na(CH3OH)Mo(NO)W4O13(OCH3)4]2-; all hydrogens explicit\\n')\n for s,p in zip(symbols,pos):f.write(f'{s:2s} {p[0]: .8f} {p[1]: .8f} {p[2]: .8f}\\n')\njson.dump({'labels':labels,'distances':cons},open('geometry.json','w'),indent=2)\nprint('Atoms:',len(symbols));print('Labels:',labels);print('Constraints:',json.dumps(cons))\nPY\npython build.py"
    }
