!='H' and a.GetSymbol()!='Cl'])],metals[1-i][None,:],bridge[None,:],p[27:29]])\n    if other is not None:others=np.vstack([others,other[:8]])\n    d=cdist(pts[:8],others)\n    norms=cdist(pts[:8],metals[i][None,:]).ravel()\n    energy=30*np.sum((ds-2.25)**2)+7*np.sum(np.maximum(0.,3.25-d)**2)+30*np.sum(np.maximum(0.,2.35-norms[np.array([2,3,6,7])])**2)\n    # avoid clash COD H with heavy core\n    hd=cdist(pts[8:],others)\n    energy+=3*np.sum(np.maximum(0.,2.60-hd)**2)\n    return energy\n\ncoords=[]\nfor i in range(2):\n    sols=[]\n    for j in range(75):\n        a=np.random.default_rng(97+j+300*i).normal(size=3);a*=np.random.default_rng(40+j).uniform(0,np.pi)/np.linalg.norm(a)\n        result=minimize(score,a,args=(i,coords[0] if i else None),method='BFGS',options={'maxiter':90})\n        sols.append((result.fun,result.x))\n    e,rr=min(sols,key=lambda t:t[0]);pose=Rotation.from_rotvec(rr).apply(q)+metals[i]+1.55*outward[i]\n    coords.append(pose);print('COD',i,'score',e,'Rh-Cdists',np.linalg.norm(pose[alk]-metals[i],axis=1))\n\natoms=symbol_core+['Rh','Rh','Cl']+2*[a.GetSymbol() for a in cod.GetAtoms()]\nxyz=np.vstack([p,ru,rl,bridge,*coords]);assert len(atoms)==len(xyz)\nwith open('answer.xyz','w') as f:\n    f.write(f'{len(atoms)}\\nDinuclear Rh(1,5-cyclooctadiene) complexes with DippN(PPh2)GeCl2 and bridging chloride\\n')\n    for a,v in zip(atoms,xyz):f.write('%-2s %13.7f %13.7f %13.7f\\n'%(a,*v))\nprint('Wrote answer.xyz',len(atoms))\nPY\npython build.py"
