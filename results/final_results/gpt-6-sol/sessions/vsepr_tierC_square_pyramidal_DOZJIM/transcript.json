iketiminate complex\\n')\n for e,v in atoms:f.write(f'{e} {v[0]:.8f} {v[1]:.8f} {v[2]:.8f}\\n')\nfor i,(e,c) in enumerate(atoms):\n if e in ('Pt','Si','N') :print(i,e,c)\nprint('total',len(atoms))\nPY\npython build.py"
