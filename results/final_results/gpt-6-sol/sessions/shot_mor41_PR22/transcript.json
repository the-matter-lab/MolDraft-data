     "command": "cat > build.py <<'PY'\nimport numpy as np\nfrom math import sin,cos,pi,sqrt\natoms=[]\ndef add(sym,xyz):\n atoms.append((sym,np.array(xyz,float))); return len(atoms)-1\nfor side in [1,-1]:\n # Ir and axial iodine; Ir-Ir axis extends along Y.\n ir=add('Ir',(0,side*1.40,0))\n add('I',(0,side*4.04,-0.22))\n for direction in [-1,1]:\n  v=np.array([direction*1.28, side*.62,1.18]); v=v/np.linalg.norm(v)\n  point=np.array([0,side*1.4,0])+1.84*v\n  add('C',point)\n  add('O',point+1.16*v)\nfor direction in [-1,1]:\n s=np.array([direction*1.80,0,-.85]); add('S',s)\n q=np.array([direction*3.03,0,.52]); add('C',q)\n a=(q-s)/np.linalg.norm(q-s)   # C--> substituents, away from S\n e1=np.array([0,1,0.]);e2=np.cross(a,e1)\n for k in range(3):\n  theta= (30+120*k)*pi/180\n  w=a/3+sqrt(8)/3*(cos(theta)*e1+sin(theta)*e2)\n  methyl=q+1.53*w; add('C',methyl)\n  b=(methyl-q)/np.linalg.norm(methyl-q) # C central to methyl\n  f=np.cross(b,[0,1,0]);f/=np.linalg.norm(f)\n  g=np.cross(b,f)\n  for j in range(3):\n   ang=(45+120*j)*pi/180\n   h=methyl+1.095*(b/3+sqrt(8)/3*(cos(ang)*f+sin(ang)*g))\n   add('H',h)\nwith open('answer.xyz','w') as f:\n f.write(f'{len(atoms)}\\nIr2(mu-StBu)2(CO)4I2, stereochemistry from diagram\\n')\n for sym, v in atoms:\n  f.write(f'{sym:2s} {v[0]: .8f} {v[1]: .8f} {v[2]: .8f}\\n')\nfor i, (si, vi) in enumerate(atoms):\n for j, (sj,vj) in enumerate(atoms[:i]):\n  r=np.linalg.norm(vi-vj)\n  if r < (2.3 if si != 'H' and sj != 'H' else 1.4):\n   print(f'{j:2d} {sj:2s} - {i:2d} {si:2s} {r:.2f}')\nPY\npython build.py; head -25 answer.xyz; tail -1 answer.xyz"
