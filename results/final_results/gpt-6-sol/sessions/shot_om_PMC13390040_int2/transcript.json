     "command": "cat > create.py <<'PY'\nimport numpy as np\nfrom scipy.spatial.transform import Rotation\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom scipy.spatial.distance import cdist\n\ndef fragment(smiles,seed=12):\n m=Chem.AddHs(Chem.MolFromSmiles(smiles))\n params=AllChem.ETKDGv3(); params.randomSeed=seed\n assert AllChem.EmbedMolecule(m,params)==0\n if AllChem.MMFFHasAllMoleculeParams(m):\n  assert AllChem.MMFFOptimizeMolecule(m,maxIters=600)==0\n else: AllChem.UFFOptimizeMolecule(m,maxIters=600)\n coord=np.array(m.GetConformer().GetPositions())\n return m,coord\n\ndef fit(A,B):\n ac=A.mean(axis=0);bc=B.mean(axis=0)\n u,s,vt=np.linalg.svd((A-ac).T@(B-bc))\n D=np.diag([1,1,np.linalg.det(u@vt)])\n rot=u@D@vt\n return rot,bc-ac@rot\n\ndef align(v,w):\n v=np.array(v,dtype=float);v/=np.linalg.norm(v);w=np.array(w,dtype=float);w/=np.linalg.norm(w)\n return Rotation.align_vectors([w],[v])[0].as_matrix().T\n# row vector transformed via @ rot\nall_symbols=[];all_coords=[];group=[]\ndef collect(m,coord, label, omit=()):\n indices={}\n for a in m.GetAtoms():\n  i=a.GetIdx()\n  if i not in omit:\n   indices[i]=len(all_symbols)\n   all_symbols.append(a.GetSymbol()); all_coords.append(coord[i]);group.append(label)\n return indices\n\nm,c=fragment('Cc1cc(O[SiH3])nc2c(C)cccc12',42)\ntarget={6:(0,2.08,0), 3:(-1.22,2.82,0), 1:(0,4.92,0),7:(1.22,2.82,0),8:(2.44,2.09,0),13:(1.22,4.21,0)}\nkeys=list(target)\nR,t=fit(c[keys],np.array([target[i] for i in keys]));c=c@R+t\nprint('ligands pre',[(i,np.round(c[i],2)) for i in (6,4,5,3,8,9)])\n# flip Si along C3-O bond to bring Si to Rh side of O. Hydrogens around Si also moved.\nvec=c[4]-c[3];vec/=np.linalg.norm(vec)\nfor angle in [0,180]:\n v=c.copy(); v[[5,18,19,20]]=(v[[5,18,19,20]]-v[4])@Rotation.from_rotvec(vec*angle, degrees=True).as_matrix().T+v[4]\n print('si',angle,np.round(v[5],2), 'O',np.round(v[4],2))\n if angle==180:c=v\n# remove Si hydrogen closest to Rh (Si->Rh points somewhat +x,-y)\nhs=[18,19,20];dot=[np.dot(c[i]-c[5],-c[5])/(np.linalg.norm(c[i]-c[5])*np.linalg.norm(c[5])) for i in hs];omit=[hs[np.argmax(dot)]];print('remove',omit)\nligand=collect(m,c,'ligand',omit)\n# phosphine: orient its empty sp3 lobe toward Rh, three Cy groups spread from Rh.\nm,c=fragment('P(C1CCCCC1)(C1CCCCC1)C1CCCCC1',42)\nP=0\nCneighbors=[a.GetIdx() for a in m.GetAtomWithIdx(0).GetNeighbors() if a.GetSymbol()=='C']\nv=np.sum(c[Cneighbors]-c[P],axis=0)\nrot=align(v,[0,-1,0]);c=(c-c[P])@rot+np.array([0,-2.25,0]);print('phosphine carbon directions',np.round(c[Cneighbors],2))\n# rotate phosphine groups around y to choose less steric overlap with aromatic group\noutside=np.array(all_coords)\nbest=None\nfor angle in range(0,360,15):\n temp=(c-np.array([0,-2.25,0]))@Rotation.from_euler('y',angle,degrees=True).as_matrix().T+np.array([0,-2.25,0]);d=cdist(temp,outside)\n # focus all heavy atom overlap, weight penalty \n e=np.sum(np.maximum(3.1-d[np.array([a.GetSymbol()!='H' for a in m.GetAtoms()])][:,np.array([s!='H' for s in all_symbols])],0)**2)\n if best is None or e<best[0]: best=(e,angle,temp)\nprint('best phosphine rot',best[:2]);c=best[2]\nphosphine=collect(m,c,'phosphine')\n# pyrrolidine ring: N toward Rh along -x, carbon ring center +x\nm,c=fragment('N1CCCC1',5)\nN=0\nCs=[a.GetIdx() for a in m.GetAtomWithIdx(0).GetNeighbors() if a.GetSymbol()=='C']\nv=np.mean(c[Cs],axis=0)-c[N]; rot=align(v,[1.0,-0.15,0]);c=(c-c[N])@rot+np.array([2.15,-.15,0]);\noutside=np.array(all_coords)\nbest=None\nfor angle in range(0,360,20):\n tmp=(c-np.array([2.15,-.15,0]))@Rotation.from_euler('x',angle,degrees=True).as_matrix().T+np.array([2.15,-.15,0]); d=cdist(tmp,outside)\n en=np.sum(np.maximum(2.9-d[np.array([a.GetSymbol()!='H' for a in m.GetAtoms()])][:,np.array([s!='H' for s in all_symbols])],0)**2)\n if best is None or en<best[0]:best=(en,angle,tmp)\nprint('best amine rot',best[:2]);c=best[2];amine=collect(m,c,'amine')\n# triflate O initially negatively charged, after metal binding still proper coordinate\nm,c=fragment('[O-]S(=O)(=O)C(F)(F)F',31)\nO=0;S=1\nrot=align(c[S]-c[O],[-0.75,-0.6,0.35]);c=(c-c[O])@rot+np.array([0.0,0,2.15])\noutside=np.array(all_coords)\nbest=None\nfor angle in range(0,360,20):\n vv=(c-np.array([0,0,2.15]))@Rotation.from_rotvec(np.array([-.75,-.6,.35])/np.linalg.norm([-.75,-.6,.35])*angle, degrees=True).as_matrix().T+np.array([0,0,2.15])\n d=cdist(vv,outside);e=np.sum(np.maximum(3.1-d[:,np.array([s!='H' for s in all_symbols])],0)**2)\n if best is None or e<best[0]:best=(e,angle,vv)\nprint('best triflate rot',best[:2]);c=best[2];trif=collect(m,c,'triflate')\nall_symbols.extend(['Rh','H']);all_coords.extend([(0,0,0),(0.05,0,-1.58)]);group.extend(['Rh','hydride'])\nall_coords=np.array(all_coords)\nwith open('initial.xyz','w') as f:\n f.write(f'{len(all_symbols)}\\nRh complex with quinoline-derived silane, PCy3, pyrrolidine, hydride, triflate\\n')\n for s,p in zip(all_symbols,all_coords):f.write('%-2s %12.6f %12.6f %12.6f\\n'%(s,*p))\nprint('atoms',len(all_symbols));print('fragment index',ligand,phosphine[0],amine[0],trif[0],len(all_symbols)-2,len(all_symbols)-1)\nfor i,j in [(len(all_symbols)-2,ligand[6]),(len(all_symbols)-2,ligand[5]),(len(all_symbols)-2,phosphine[0]),(len(all_symbols)-2,amine[0]),(len(all_symbols)-2,trif[0]),(len(all_symbols)-2,len(all_symbols)-1)]:print(i,j, 'bond distance:',np.linalg.norm(all_coords[i]-all_coords[j]))\nPY\npython create.py"
