     "command": "cat > complex.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import least_squares\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom scipy.spatial.transform import Rotation\nD=np.load('conformers.npz');coords=D['coords'];els=D['elems'].tolist()\ncp=Chem.AddHs(Chem.MolFromSmiles('C[c-]1c(C)c(C)c(C)c1C'))\nprint('cp',cp.GetNumAtoms(),AllChem.EmbedMolecule(cp,randomSeed=80),AllChem.MMFFHasAllMoleculeParams(cp))\nif AllChem.MMFFHasAllMoleculeParams(cp): print('cp opt',AllChem.MMFFOptimizeMolecule(cp))\nq=cp.GetConformer().GetPositions(); qels=[a.GetSymbol() for a in cp.GetAtoms()]\nring=np.array([1,2,4,6,8]); c=q[ring].mean(axis=0); q-=c\nfrom scipy.spatial.distance import cdist\nfor k in [75,112,91,30,66,98]:\n p=coords[k].copy(); ns=[2,11,18]; bb=[(1,3),(1,12),(13,17)]\n def residual(x):\n  x=x[:3];v=p[ns]-x;ds=np.linalg.norm(v,axis=1)\n  bis=[]\n  for j,ng in zip(ns,bb):\n   nn=p[list(ng)].mean(axis=0)-p[j];nn/=np.linalg.norm(nn)\n   bis.append(np.dot((x-p[j])/np.linalg.norm(x-p[j]),nn))\n  return np.r_[(ds-2.09)*4,np.maximum(np.array(bis)+0.55,0)*1.6]\n a,b,cc=p[ns]; normal=np.cross(a-b,cc-b);normal/=np.linalg.norm(normal)\n best=sorted([least_squares(residual,p[ns].mean(axis=0)+v*normal*1.35,max_nfev=100) for v in [-1,1]],key=lambda z:np.linalg.norm(z.fun))[0]\n ir=best.x;v=p[ns].mean(axis=0)-ir;v/=np.linalg.norm(v)\n # place cp centroid opposite from organic, cp normal e3 points from ir to centroid; q ring normal rigidly map onto axis\n t=-v; cen=ir+1.84*t\n source=np.cross(q[2]-q[1],q[4]-q[1]);source/=np.linalg.norm(source)\n align,_=Rotation.align_vectors([t],[source]);base=align.apply(q)\n scbest=None\n for ang in np.linspace(0,2*np.pi,72):\n  qq=Rotation.from_rotvec(t*ang).apply(base)+cen\n  distances=cdist(qq,p)\n  norm=np.array([1.6 if e=='H' else (1.8 if e in 'NOF' else 1.9) for e in els])\n  cpnorm=np.array([1.2 if e=='H' else 1.8 for e in qels])\n  # exclude metal lig donor interactions but cp all normal ligand contacts should >=2.5 CH\n  diff=distances-(cpnorm[:,None]+norm[None,:]);pen=np.minimum(diff,0)\n  cost=np.sum(pen**2)\n  if scbest is None or cost<scbest[0]:scbest=(cost,qq)\n qq=scbest[1];print('candidate',k,'cost',np.linalg.norm(best.fun),'cpclash',scbest[0], 'irN',np.linalg.norm(p[ns]-ir,axis=1))\n elements=els+['Ir']+qels;xyz=np.vstack([p,ir,qq]);out=f'start_{k}.xyz'\n with open(out,'w') as f:\n  f.write(f'{len(elements)}\\nIr Cp* NNN complex +1, initial conformer {k}\\n')\n  for e,r in zip(elements,xyz):f.write(f'{e:2s} {r[0]: .7f} {r[1]: .7f} {r[2]: .7f}\\n')\nPY\nOPENBLAS_NUM_THREADS=1 python complex.py"
