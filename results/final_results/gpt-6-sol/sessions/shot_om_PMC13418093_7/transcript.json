     "command": "cat > assemble.py <<'PY'\nimport numpy as np\nfrom scipy.spatial.transform import Rotation\nfrom scipy.spatial.distance import cdist\nxyz=open('ligand.xyz').read().splitlines()[2:]\nelems=[s.split()[0] for s in xyz]; co=np.array([list(map(float,s.split()[1:])) for s in xyz]); p=co[1].copy(); co-=p\naxis=np.array([0.,0.,0.]);\nfor i in (0,2,3): axis-=co[i]/np.linalg.norm(co[i]); axis/=np.linalg.norm(axis)\nrot,_=Rotation.align_vectors([[1,0,0]],[axis]); co=rot.apply(co)\n# position aryl 3 in mostly -z direction\nq=co[3]; angle=np.arctan2(q[1],-q[2]); co=Rotation.from_rotvec([angle,0,0]).apply(co)\n# fixed metallic / cp coords\nm=[('Ir', np.zeros(3))]\nfor sign in [-1,1]:\n    m.append(('C',np.array([1.04,sign*1.80,-.30])))\n    cc=m[-1][1]; d=cc/np.linalg.norm(cc)\n    u=np.cross(d,[0,0,1]);u/=np.linalg.norm(u);v=np.cross(d,u)\n    for a in np.arange(3)*np.pi*2/3:\n        m.append(('H',cc+1.09*(d/3+np.sqrt(8/9)*(np.cos(a)*u+np.sin(a)*v))))\nfor k in range(5):\n    t=2*np.pi*k/5+np.radians(18)\n    d=np.array([np.cos(t), np.sin(t),0.])\n    cc=d*1.18+np.array([0,0,1.95]); m.append(('C',cc))\n    mm=cc+1.51*d; m.append(('C',mm))\n    u=np.array([0,0,1.]);v=np.cross(d,u)\n    for a in np.arange(3)*np.pi*2/3:\n        m.append(('H',mm+1.09*(d/3+np.sqrt(8/9)*(np.cos(a)*u+np.sin(a)*v))))\nme=np.array([a[1] for a in m]);\nbest=None\nfor deg in range(-180,180,10):\n    trial=Rotation.from_rotvec(np.radians(deg)*np.array([1,0,0])).apply(co)+np.array([-2.33,0.,-.30])\n    d=cdist(trial,me)\n    # ligand vs ir except phosphorus; ligand vs ir methyls, cp carbons and methyls\n    d[1,0]=99\n    soft=np.array([3.45 if e=='C' else 2.95 if e=='H' else 3.25 for e in elems])[:,None]\n    cme=np.array([2.6 if e=='Ir' else 3.45 if e=='C' else 2.95 for e,_ in m])[None,:]\n    threshold=(soft+cme)/2\n    threshold[1,0]=0\n    energy=np.sum(np.clip(threshold-d,0,None)**2)\n    # make P->aryl point away from Cp, pref aryl z negative\n    energy+=2.5*max(0,(trial[3]-trial[1])[2]+0.5)**2\n    if best is None or energy<best[0]:best=(energy,deg,trial,d)\nprint('best', best[0:2]); print('p->aryl',best[2][3]-best[2][1]);\nprint('closest ligand-vs-metal',[(i, j, elems[i], m[j][0], round(best[3][i,j],2)) for i,j in zip(*np.where(best[3]<2.6))][:35])\nall_coords=list(zip(elems,best[2]))+m\nwith open('start.xyz','w') as f:\n f.write(f'{len(all_coords)}\\nCp*Ir(Me)2(PMe2-2,6-bis(3,5-di-tert-butylphenyl)phenyl) starting geometry\\n')\n for a,r in all_coords: f.write('%s % .7f % .7f % .7f\\n'%(a,*r))\nprint('total',len(all_coords));print('metal indices',[(i,e) for i,(e,_) in enumerate(all_coords) if i>=88 and e!='H'])\nPY\nOPENBLAS_NUM_THREADS=1 python assemble.py"
