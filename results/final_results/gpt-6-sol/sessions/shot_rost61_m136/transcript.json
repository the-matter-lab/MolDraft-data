    "name": "bash_kernel",
    "args": {
     "command": "cat > build.py <<'PY'\nimport numpy as np\nfrom rdkit import Chem\nfrom scipy.spatial.distance import cdist\nfrom scipy.spatial.transform import Rotation\nfrom scipy.optimize import differential_evolution\np=Chem.MolFromSmiles('n1ccccc1')\nd=Chem.MolFromSmiles('[O-]C(=O)c1cccc(C(=O)[O-])n1')\n# dipicolinate: 0 upper coordinating O, 1/8 carboxyl carbon, 2/9 terminal O, 10 lower coordinating O, 11 pyridine N\ncoords_d=np.array([\n[-.84, 2.21,.23],[-2.14,2.43,0],[-2.67,3.55,-.15],[-2.98,1.19,0],[-4.36,1.19,0],[-5.05,0,0],[-4.36,-1.19,0],[-2.98,-1.19,0],[-2.14,-2.43,0],[-2.67,-3.55,-.15],[-.84,-2.21,.23],[-2.30,0,0],\n])\n# heavy atom pyridines around radial coordinate d, orient ring plane rotation phi around radial axis\n# center PY N; N->C alpha delta = 0.68 * d +/- 1.17 * perpendicular\npy_centers=[np.array([2.40,0,0]),np.array([1.29,1.99,-.73]),np.array([1.29,-1.99,-.73])]\naxes=[np.array([1.,0.,0.]),np.array([.76,.65,0]),np.array([.76,-.65,0])]\ndef pyxyz(idx,phi):\n d=axes[idx]/np.linalg.norm(axes[idx]); side=np.cross([0.,0.,1.],d); side=Rotation.from_rotvec(d*phi).apply(side)\n n=py_centers[idx]\n return np.array([n,n+.69*d+1.18*side,n+2.07*d+1.18*side,n+2.76*d,n+2.07*d-1.18*side,n+.69*d-1.18*side])\ndef score(phis):\n groups=[coords_d]+[pyxyz(i,phi) for i,phi in enumerate(phis)]\n s=0\n for i in range(4):\n  for j in range(i+1,4):\n   x=cdist(groups[i],groups[j]); cutoff=2.55 if i == 0 else 2.85\n   s+=np.sum(np.clip(cutoff-x,0,None)**2)*30\n # pyramidal donor geometry along backward face py top and bottom N\n return s\nsol=differential_evolution(score,[(0,2*np.pi)]*3,seed=76,popsize=14,maxiter=160)\nprint('phis:',sol.x,'cost',sol.fun)\nfor i,phi in enumerate(sol.x):print('pyridine',i,pyxyz(i,phi))\nfrags=[(d,coords_d)]+[(p,pyxyz(i,phi)) for i,phi in enumerate(sol.x)]\nwhole=Chem.RWMol()\nxyz=[]\nfor mol,cs in frags:\n for a,coord in zip(mol.GetAtoms(),cs):\n  a2=Chem.Atom(a.GetSymbol());a2.SetFormalCharge(a.GetFormalCharge());a2.SetIsAromatic(a.GetIsAromatic());whole.AddAtom(a2);xyz.append(coord)\n off=len(xyz)-mol.GetNumAtoms()\n for bond in mol.GetBonds(): whole.AddBond(bond.GetBeginAtomIdx()+off,bond.GetEndAtomIdx()+off,bond.GetBondType())\nag=Chem.Atom('Ag');ag.SetFormalCharge(2);whole.AddAtom(ag);xyz.append(np.array([0.,0.,0.]))\nwhole=whole.GetMol()\nChem.SanitizeMol(whole)\nconf=Chem.Conformer(len(xyz))\nfor i,c in enumerate(xyz):conf.SetAtomPosition(i,c)\nwhole.AddConformer(conf)\nwhole=Chem.AddHs(whole,addCoords=True)\nxyz=np.array(whole.GetConformer().GetPositions())\nwith open('start.xyz','w') as f:\n f.write(f'{len(xyz)}\\nAg(II) dipicolinate tris(pyridine), charge 0 doublet\\n')\n for a,c in zip(whole.GetAtoms(),xyz):f.write(f'{a.GetSymbol():2s} {c[0]: .9f} {c[1]: .9f} {c[2]: .9f}\\n')\nprint('atoms',len(xyz),'Ag index',12+18,'py Ns',[12,18,24],'DPA N 11, O 0 10')\nPY\npython build.py"
