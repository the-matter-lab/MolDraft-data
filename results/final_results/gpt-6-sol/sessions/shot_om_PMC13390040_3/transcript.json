     "command": "cat > rearrange.py <<'PY'\nimport numpy as np\nfrom scipy.spatial.transform import Rotation\nf=open('opt.xyz').readlines(); e=[r.split()[0] for r in f[2:] if len(r.split())==4];x=np.array([[float(z) for z in r.split()[1:]] for r in f[2:] if len(r.split())==4]);rh=x[43]\ndef unit(v):return v/np.linalg.norm(v)\ndef move_fragment(x, ids, lead, target):\n source=unit(x[lead]-rh);target=unit(target)\n rot=Rotation.align_vectors([target],[source])[0]; y=x.copy();\n for i in ids:y[i]=rh+rot.apply(x[i]-rh)\n delta=rh+target*np.linalg.norm(x[lead]-rh)-y[lead];y[ids]+=delta\n return y\npids=list(range(16,35))+list(range(61,94));oids=list(range(35,43));\nn=unit(x[8]-rh);si=unit(x[5]-rh);a=unit(x[56]-rh)\nnorm=unit(np.cross(n,si))\nprint('ortho',n@si,n@a,si@a,'norm agostic',a@norm)\nfor sign in [1,-1]:\n y=move_fragment(x,pids,16,-n)\n # projected normal to scaffold: n si approximately 90\n target=unit(norm*sign + 0.1*(-n))\n y=move_fragment(y,oids,35,target)\n y[44]=rh-target*1.57\n clash=[]\n for i in pids+oids+[44]:\n  for j in range(len(x)):\n   if j in pids+oids+[44] or j==43:continue\n   dist=np.linalg.norm(y[i]-y[j]);\n   if dist<1.55 and e[i]!='H' and e[j]!='H':clash.append((i,j,round(dist,2)))\n print('sign',sign,'clash',clash[:22]);\n with open(f'swap_{sign}.xyz','w') as out:\n  out.write(f'{len(y)}\\nRearranged trans ligand geometry: {sign}\\n')\n  for el,p in zip(e,y):out.write(f'{el} {p[0]:.9f} {p[1]:.9f} {p[2]:.9f}\\n')\nPY\npython rearrange.py"
    }
