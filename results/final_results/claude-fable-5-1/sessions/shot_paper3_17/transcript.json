  "tool_calls": [
   {
    "name": "bash_kernel",
    "args": {
     "command": "cat << 'EOF' > build2.py\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nimport numpy as np\n\ndef embed(smi, seed=42):\n    m = Chem.AddHs(Chem.MolFromSmiles(smi))\n    AllChem.EmbedMolecule(m, randomSeed=seed)\n    AllChem.MMFFOptimizeMolecule(m, maxIters=2000)\n    return m\n\n# ligand (S configuration)\nlig = embed('O=C(C(C)(C)C)O[C@@H](c1ccccc1)c1ccc2ccccc2c1')\n# naphthalene atoms: in SMILES, index 14 = C2 (bearing substituent), 15 = C3, ..., 23 = C1 (last 'c1')\npatt = Chem.MolFromSmarts('[CH]([O])(c1ccccc1)c1cc2ccccc2c1')\n# simpler: identify C2 and C1 directly\nc2 = 14\nnbrs = [a.GetIdx() for a in lig.GetAtomWithIdx(c2).GetNeighbors()]\nprint('C2 neighbours', nbrs, [lig.GetAtomWithIdx(i).GetSymbol() for i in nbrs])\nc1 = 23  # C1 adjacent to ring fusion\nassert c1 in nbrs\nL = lig.GetConformer().GetPositions()\nring = [14,15,16,17,22,23]\ncen = L[ring].mean(axis=0)\n# normal of ring\nu,s,vt = np.linalg.svd(L[ring]-cen)\nn = vt[2]\nmid = (L[c1]+L[c2])/2\n# choose face: away from the benzylic substituent's H? just pick side away from the stereocentre's bulk (C7 with Ph)\nsub = L[7]\nif np.dot(sub-mid, n) > 0: n = -n\nNi = mid + 1.95*n   # Ni-C ~ 2.05 A approx\n# SIMes\nsimes = embed('C1N(c2c(C)cc(C)cc2C)[C]N1c1c(C)cc(C)cc1C')\nS = simes.GetConformer().GetPositions()\ncc = [a.GetIdx() for a in simes.GetAtoms() if a.GetSymbol()=='C' and a.GetDegree()==2 and all(nb.GetSymbol()=='N' for nb in a.GetNeighbors())][0]\nNs = [a.GetIdx() for a in simes.GetAtomWithIdx(cc).GetNeighbors()]\n# carbene direction: from midpoint of N-N to carbene C\nd = S[cc] - (S[Ns[0]]+S[Ns[1]])/2; d/=np.linalg.norm(d)\n# ring normal of NHC\nnn = np.cross(S[Ns[0]]-S[cc], S[Ns[1]]-S[cc]); nn/=np.linalg.norm(nn)\n# target: carbene C at Ni + 1.9*n, with d pointing to -n ; NHC plane normal along C1-C2 bond direction (so N-C-N plane perpendicular to C=C)\nbond = L[c2]-L[c1]; bond -= np.dot(bond,n)*n; bond/=np.linalg.norm(bond)\n# build rotation: source frame (d, nn, d x nn) -> target (-n, bond, (-n) x bond)\nsrc = np.array([d, nn, np.cross(d,nn)])\ntgt = np.array([-n, bond, np.cross(-n,bond)])\nR = tgt.T @ src\nS2 = (S - S[cc]) @ R.T + Ni + 1.90*n\natoms = [(a.GetSymbol(), L[a.GetIdx()]) for a in lig.GetAtoms()]\natoms.append(('Ni', Ni))\natoms += [(a.GetSymbol(), S2[a.GetIdx()]) for a in simes.GetAtoms()]\nwith open('init.xyz','w') as f:\n    f.write(f'{len(atoms)}\\ninitial guess\\n')\n    for s,p in atoms:\n        f.write(f'{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n')\nprint(len(atoms), 'Ni index', len(lig.GetAtoms()))\n# min distance check\nP = np.array([p for s,p in atoms])\nD = np.linalg.norm(P[:,None]-P[None],axis=2); np.fill_diagonal(D,9)\nprint('min dist', D.min())\nEOF\npython build2.py"
    }
