    "name": "bash_kernel",
    "args": {
     "command": "cat > build.py << 'EOF'\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\n\n# chelate fragment with dummy H on Ga\nsmi = \"[GaH]1N=C(C)CC(C2(C)C(C)=C(C)C(C)=C2C)=[NH+]1\"\nm = Chem.AddHs(Chem.MolFromSmiles(smi))\nAllChem.EmbedMolecule(m, randomSeed=42)\nAllChem.MMFFOptimizeMolecule(m) if False else None\nconf = m.GetConformer()\natoms=[]; \nga_idx=[a.GetIdx() for a in m.GetAtoms() if a.GetSymbol()=='Ga'][0]\nhdum=[n.GetIdx() for n in m.GetAtomWithIdx(ga_idx).GetNeighbors() if n.GetSymbol()=='H'][0]\npos=np.array(conf.GetPositions())\nga=pos[ga_idx]; v=pos[hdum]-ga; v/=np.linalg.norm(v)\nNi=ga+2.35*v\nfor a in m.GetAtoms():\n    if a.GetIdx()==hdum: continue\n    atoms.append((a.GetSymbol(), pos[a.GetIdx()]))\natoms.append(('Ni',Ni))\n# tetrahedral directions: first is -v (Ni->Ga chelate)\nd0=-v\n# build orthonormal basis\ntmp=np.array([1,0,0]) if abs(d0[0])<0.9 else np.array([0,1,0])\ne1=np.cross(d0,tmp); e1/=np.linalg.norm(e1); e2=np.cross(d0,e1)\ndirs=[]\nfor k in range(3):\n    ang=2*np.pi*k/3\n    d=-d0*(1/3)+np.sqrt(8/9)*(np.cos(ang)*e1+np.sin(ang)*e2)\n    dirs.append(d/np.linalg.norm(d))\ndef cpstar(center_dir, Ni, k):\n    out=[]\n    Ga=Ni+2.3*center_dir\n    out.append(('Ga',Ga))\n    cen=Ga+2.05*center_dir\n    t=np.array([1,0,0]) if abs(center_dir[0])<0.9 else np.array([0,1,0])\n    a1=np.cross(center_dir,t); a1/=np.linalg.norm(a1); a2=np.cross(center_dir,a1)\n    for i in range(5):\n        ang=2*np.pi*i/5+k\n        rdir=np.cos(ang)*a1+np.sin(ang)*a2\n        C=cen+1.22*rdir\n        Me=cen+2.72*rdir+0.1*center_dir\n        out.append(('C',C)); out.append(('C',Me))\n        # methyl Hs\n        b=(Me-C); b/=np.linalg.norm(b)\n        p1=np.cross(b,center_dir); p1/=np.linalg.norm(p1); p2=np.cross(b,p1)\n        for j in range(3):\n            a=2*np.pi*j/3\n            H=Me+1.09*(b*0.33+0.94*(np.cos(a)*p1+np.sin(a)*p2))\n            out.append(('H',H))\n    return out\nfor k,d in enumerate(dirs):\n    atoms+=cpstar(d,Ni,k*0.4)\nwith open('init.xyz','w') as f:\n    f.write(f\"{len(atoms)}\\ninit\\n\")\n    for s,p in atoms:\n        f.write(f\"{s} {p[0]:.4f} {p[1]:.4f} {p[2]:.4f}\\n\")\nprint(len(atoms))\nEOF\npython build.py"
