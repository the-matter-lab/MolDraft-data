    "args": {
     "command": "cat > build.py <<'PY'\nimport numpy as np, json\natoms=[];bond=[];angles=[];labels={}\ndef add(e,p,label):\n i=len(atoms);atoms.append((e,np.array(p,dtype=float)));labels[label]=i;return i\ndef b(i,j,d): bond.append({'atoms':[i,j],'value':d})\ncentral=add('O',[0,0,0],'central O')\nw=[]\nfor k,vec in enumerate([[1,0,0],[0,1,0],[-1,0,0],[0,-1,0]]):\n v=np.array(vec,dtype=float);i=add('W',2.35*v,f'W{k+1}');w.append(i);b(central,i,2.35)\nmo=add('Mo',[0,0,-2.35],'Mo');b(central,mo,2.35)\nna=add('Na',[0,0,3.15],'Na')\nfor k,i in enumerate(w):\n v=atoms[i][1]/2.35\n term=add('O',(2.35+1.72)*v,f'W{k+1} terminal O');b(i,term,1.72)\n # Na coordinated bridging oxide\n o=add('O',1.86*v+np.array([0,0,1.84]),f'W{k+1}-Na O');b(i,o,1.90);b(na,o,2.30)\n # Equatorial oxide to next W\n vnext=atoms[w[(k+1)%4]][1]/2.35\n o=add('O',1.78*(v+vnext),f'W{k+1}-W{(k+1)%4+1} O');b(i,o,1.87);b(w[(k+1)%4],o,1.87)\n # Methoxide bridging to Mo\n o=add('O',1.98*v+np.array([0,0,-1.98]),f'W{k+1}-Mo methoxide O');b(i,o,2.02);b(mo,o,2.02)\n axis=(v+np.array([0,0,-1]))/np.sqrt(2)\n c=add('C',atoms[o][1]+1.43*axis,f'methoxide {k+1} C');b(o,c,1.43)\n # Three tetrahedral methyl hydrogens, bond from carbon to O is -axis\n u=np.cross(axis,[0,0,1]);u/=np.linalg.norm(u);t=np.cross(axis,u)\n for j in range(3):\n  a=2*np.pi*j/3\n  d=axis/3+np.sqrt(8/9)*(np.cos(a)*u+np.sin(a)*t)\n  h=add('H',atoms[c][1]+1.09*d,f'methoxide {k+1} H{j+1}');b(c,h,1.09)\nn=add('N',[0,0,-4.12],'nitrosyl N');b(mo,n,1.77)\no=add('O',[0,0,-5.29],'nitrosyl O');b(n,o,1.17);angles.append({'atoms':[mo,n,o],'value':180.0})\n# coordinated methanol above the sodium apex\nom=add('O',[0,0,5.45],'methanol O');b(na,om,2.30)\naxis=np.array([np.sin(np.radians(65)),0,np.cos(np.radians(65))])\nc=add('C',atoms[om][1]+1.43*axis,'methanol C');b(om,c,1.43)\nu=np.array([0,1.,0]);t=np.cross(axis,u)\nfor j in range(3):\n a=2*np.pi*j/3\n d=axis/3+np.sqrt(8/9)*(np.cos(a)*u+np.sin(a)*t)\n h=add('H',atoms[c][1]+1.09*d,f'methanol methyl H{j+1}');b(c,h,1.09)\na=np.radians(65+108)\nh=add('H',atoms[om][1]+.97*np.array([np.sin(a),0,np.cos(a)]),'methanol OH H');b(om,h,.97)\nwith open('initial.xyz','w') as f:\n f.write(f'{len(atoms)}\\n[Na(MeOH)Mo(NO)W4O13(OMe)4]2-; all H explicit\\n')\n for e,p in atoms:f.write(f'{e:2s} {p[0]: .9f} {p[1]: .9f} {p[2]: .9f}\\n')\njson.dump({'labels':labels,'bonds':bond,'angles':angles},open('model.json','w'),indent=2)\nprint('Atoms:',len(atoms));print(labels)\n# only metal-oxygen and nitrosyl constraints; relaxed organic geometry\nmetal_bonds=[bb for bb in bond if any(atoms[k][0] in ['W','Mo','Na'] for k in bb['atoms']) or bb['atoms']==[n,o]]\njson.dump(metal_bonds,open('constraints.json','w'),indent=2)\nPY\npython build.py"
