     "command": "cat >> build.py <<'PY'\nanchors={1:np.array([-1.55,0,-1.8]),25:np.array([1.55,0,-1.8]),22:np.array([0,-2.05,0]),47:np.array([0,2.05,0])}\nmp=AllChem.MMFFGetMoleculeProperties(m)\nresults=[]\nfor seed in range(20):\n mol=Chem.Mol(m)\n ret=AllChem.EmbedMolecule(mol,randomSeed=seed+104,coordMap={i:Point3D(*r) for i,r in anchors.items()},useRandomCoords=True,maxAttempts=30)\n if ret<0: print('fail',seed);continue\n ff=AllChem.MMFFGetMoleculeForceField(mol,mp)\n for i in anchors: ff.MMFFAddPositionConstraint(i,0,1000)\n ff.Initialize();ff.Minimize(maxIts=2000)\n xyz=mol.GetConformer().GetPositions()\n # account for clash with metal, bridging and terminal methyl atoms\n ext=np.array([[0,0,0],[0,0,3.5],[-1.45,0,1.93],[1.45,0,1.93],[-1.1,-1.25,4.55],[1.1,1.25,4.55]])\n d=np.linalg.norm(xyz[:,None,:]-ext[None,:,:],axis=-1)\n idx=[i for i in range(mol.GetNumAtoms()) if i not in anchors]\n rep=np.sum(np.maximum(0,2.6-d[idx,0])**2)*100+np.sum(np.maximum(0,2.8-d[:,1:])**2)*100\n e=ff.CalcEnergy()\n print(seed, e, rep, 'Ocarbons',np.round(xyz[[21,46]],2).tolist())\n results.append((e+rep,mol,xyz,e,rep))\nresults.sort(key=lambda x:x[0])\n_,mol,xyz,e,rep=results[0]\nprint('Best',e,rep)\nChem.MolToMolFile(mol,'ligand_conf.mol')\nnp.save('ligand.npy',xyz)\n# methyl groups, tetrahedral ideal relative to Al for all four\nsymbols=[a.GetSymbol() for a in mol.GetAtoms()]+['Hf','Al']\ncoords=list(xyz)+[np.array([0,0,0]),np.array([0,0,3.5])]\nfor c in ext[2:]:\n symbols.append('C');coords.append(c)\n # bridge methyl hydrogens away from metal centroid, term away from Al\n axis=c-(ext[0]+ext[1])/2 if abs(c[2]-1.93)<.01 else c-ext[1]\n axis=axis/np.linalg.norm(axis)\n ref=np.array([0,1,0]);v=np.cross(axis,ref);v/=np.linalg.norm(v);w=np.cross(axis,v)\n for k in range(3):\n  theta=2*np.pi*k/3\n  vec=axis/3+np.sqrt(8/9)*(v*np.cos(theta)+w*np.sin(theta))\n  symbols.append('H');coords.append(c+1.09*vec)\ncoords=np.array(coords)\nwith open('initial.xyz','w') as f:\n f.write(f'{len(symbols)}\\nCationic Hf-Al dimethyl-bridged amino-bisphenolate complex, charge +1\\n')\n for s,r in zip(symbols,coords):f.write(f'{s} {r[0]:.8f} {r[1]:.8f} {r[2]:.8f}\\n')\nPY\nOPENBLAS_NUM_THREADS=1 python build.py > build.log 2>&1; tail -25 build.log",
