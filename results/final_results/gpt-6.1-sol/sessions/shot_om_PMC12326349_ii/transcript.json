   {
    "name": "bash_kernel",
    "args": {
     "command": "cat > build.py <<'PY'\nimport numpy as np\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom rdkit.Chem.rdMolTransforms import GetDihedralDeg\nm=Chem.AddHs(Chem.MolFromSmiles('N=C(C)C1(C)C(C)=C(C)C(C)=C1C'))\nAllChem.EmbedMolecule(m,randomSeed=42)\nAllChem.UFFOptimizeMolecule(m,maxIters=1000)\nfor a in m.GetAtoms():print(a.GetIdx(),a.GetSymbol(),[n.GetIdx() for n in a.GetNeighbors()])\nconf=m.GetConformer()\n# H on imine N\nhN=[a.GetIdx() for a in m.GetAtomWithIdx(0).GetNeighbors() if a.GetSymbol()=='H'][0]\nprint('H-N=C-ring dihedral:',GetDihedralDeg(conf,hN,0,1,3))\n# Force same-side N-H and ring substituent (this becomes N-Ga).\nff=AllChem.UFFGetMoleculeForceField(m)\nff.UFFAddTorsionConstraint(hN,0,1,3,False,-1,1,100)\nff.Minimize(maxIts=2000)\nprint('optimized dihedral:',GetDihedralDeg(conf,hN,0,1,3))\nChem.MolToMolFile(m,'organic.mol')\n# Place N at Ga + 2.0*(cos30,sin30,0). Match C-N into the xy plane\np=np.array(conf.GetPositions())\nhdir=(p[hN]-p[0]); hdir/=np.linalg.norm(hdir)\ncd=(p[1]-p[0]); cd/=np.linalg.norm(cd)\n# map N-H to (-cos30,-sin30,0), N=C pointing right/down\nsrc_x=hdir;src_y=cd-np.dot(cd,hdir)*hdir;src_y/=np.linalg.norm(src_y);src_z=np.cross(src_x,src_y)\ntgt_x=np.array([-np.sqrt(3)/2,-.5,0]);tgt_y=np.array([.5,-np.sqrt(3)/2,0]);tgt_z=np.cross(tgt_x,tgt_y)\nR=np.column_stack([tgt_x,tgt_y,tgt_z])@np.column_stack([src_x,src_y,src_z]).T\nGa_right=np.array([2.40,0,0]); N=Ga_right-2.02*tgt_x\np=(p-p[0])@R.T+N\natoms=[]; groups=[]\ndef add(s,p):\n atoms.append((s,np.array(p)));return len(atoms)-1\nNi=add('Ni',[0,0,0])\nGas=[add('Ga',[-1.2,0,-2.4*np.sqrt(3)/2]),add('Ga',[-1.2,0,2.4*np.sqrt(3)/2]),add('Ga',[0,-2.4,0]),add('Ga',Ga_right)]\n# nitrile including methyl protons\nnit=add('N',[0,1.90,0]);cn=add('C',[0,3.07,0]);cm=add('C',[0,4.52,0])\nfor t in range(3):\n th=2*np.pi*t/3\n add('H',np.array([0,4.52,0])+1.09*np.array([np.sqrt(8/9)*np.cos(th),1/3,np.sqrt(8/9)*np.sin(th)]))\n# Three eta5-Cp* ligands\nring_ids=[]\nfor gi,phase in zip(Gas[:3],[.05,.4,.3]):\n ga=atoms[gi][1];n=ga/np.linalg.norm(ga); center=ga+1.90*n\n u=np.array([0.,1.,0.]) if abs(n[1])<.9 else np.array([1.,0.,0.])\n u-=np.dot(u,n)*n;u/=np.linalg.norm(u);v=np.cross(n,u)\n ring=[]\n for i in range(5):\n  th=2*np.pi*i/5+phase;out=np.cos(th)*u+np.sin(th)*v; tangent=np.cross(n,out)\n  ring.append(add('C',center+1.21*out))\n  methyl=center+2.71*out;add('C',methyl)\n  for j in range(3):\n   angle=2*np.pi*j/3+.3\n   hdir=out/3+np.sqrt(8/9)*(tangent*np.cos(angle)+n*np.sin(angle))\n   add('H',methyl+1.09*hdir)\n ring_ids.append(ring)\norgmap={}\nfor i,a in enumerate(m.GetAtoms()):\n if i!=hN:orgmap[i]=add(a.GetSymbol(),p[i])\n# Shift centroid to origin\ncentroid=np.mean([p for _,p in atoms],axis=0)\nwith open('initial.xyz','w') as f:\n f.write(f'{len(atoms)}\\nNi gallium Cp* complex; charge +2; all hydrogens explicit\\n')\n for s,pt in atoms:f.write(f'{s} {pt[0]-centroid[0]:.9f} {pt[1]-centroid[1]:.9f} {pt[2]-centroid[2]:.9f}\\n')\nimport json\njson.dump(dict(Ni=Ni,Gas=Gas,nit=nit,cn=cn,cm=cm,rings=ring_ids,orgmap=orgmap),open('ids.json','w'))\nprint('Written',len(atoms),'atoms; organic atoms',len(orgmap))\nPY\npython build.py"
    }
