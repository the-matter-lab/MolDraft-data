     "command": "cat <<'PY' > /tmp/make.py\nimport numpy as np\natoms=[]\ncoords=[]\ndef add(e,p): atoms.append(e); coords.append(p)\nadd('Mo',[0,0,0])\n# Cp ring centroids and outward normals\ncenters=[np.array([-0.9063078,0,0.4226183])*2.0, np.array([-0.9063078,0,-0.4226183])*2.0]\nfor idx,c in enumerate(centers):\n    n=c/np.linalg.norm(c)\n    # choose tangent basis; same-ish orientation\n    u=np.array([0.,1.,0.])\n    u=u-np.dot(u,n)*n; u=u/np.linalg.norm(u)\n    v=np.cross(n,u)\n    # phase rotate rings slightly\n    phase=0.15 if idx==0 else 0.15\n    for j in range(5):\n        th=2*np.pi*j/5+phase\n        radial=np.cos(th)*u+np.sin(th)*v\n        p=c+1.20*radial\n        add('C',p)\n    for j in range(5):\n        th=2*np.pi*j/5+phase\n        radial=np.cos(th)*u+np.sin(th)*v\n        p=c+2.28*radial\n        add('H',p)\nfor v in [np.array([.5,.8660254,0]),np.array([.5,-.8660254,0])]: add('I',v*2.65)\nwith open('molstart.xyz','w') as f:\n    f.write(f'{len(atoms)}\\ninitial Cp2MoI2\\n')\n    for e,p in zip(atoms,coords): f.write(f'{e} {p[0]:.8f} {p[1]:.8f} {p[2]:.8f}\\n')\nPY\npython /tmp/make.py"
    }
