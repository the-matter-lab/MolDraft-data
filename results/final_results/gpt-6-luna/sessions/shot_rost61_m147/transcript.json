     "command": "cat << 'PY' > /tmp/build.py\nimport numpy as np\nfrom math import sin,cos,pi,sqrt\natoms=[]; xyz=[]\ndef add(e,p): atoms.append(e); xyz.append(np.array(p,dtype=float))\n# yttrium at center\nadd('Y',[0,0,0])\nR=2.45; rc=1.22\nfor k in range(3):\n    phi=2*pi*k/3\n    u=np.array([cos(phi),sin(phi),0.])\n    t=np.array([-sin(phi),cos(phi),0.])\n    z=np.array([0.,0.,1.])\n    center=R*u\n    # Cp ring, substituted carbon at +t vertex\n    ring=[]\n    for j in range(5):\n        a=2*pi*j/5\n        pos=center+rc*(cos(a)*t+sin(a)*z)\n        add('C',pos); ring.append(len(atoms)-1)\n    # Hs on the non-substituted ring carbons, radially out from center\n    for j,idx in enumerate(ring):\n        if j==0: continue\n        a=2*pi*j/5\n        radial=cos(a)*t+sin(a)*z\n        add('H',xyz[idx]+1.09*radial)\n    # Si substituent at ring carbon j=0\n    c=xyz[ring[0]]\n    si=c+1.88*t\n    add('Si',si); siidx=len(atoms)-1\n    # three methyl groups around Si, tetrahedral relative to Si-Cring bond (-t)\n    b0=-t\n    v=np.array([0.,0.,1.])\n    # choose perpendicular basis to b0\n    e1=z - np.dot(z,b0)*b0\n    if np.linalg.norm(e1)<1e-7: e1=t\n    e1=e1/np.linalg.norm(e1)\n    e2=np.cross(b0,e1); e2=e2/np.linalg.norm(e2)\n    for m in range(3):\n        ang=2*pi*m/3\n        d=(1/3)*t+sqrt(8/9)*(cos(ang)*e1+sin(ang)*e2)\n        d=d/np.linalg.norm(d)\n        cm=si+1.88*d\n        add('C',cm); cmidx=len(atoms)-1\n        # hydrogens tetrahedral around methyl carbon, excluding Si bond\n        to_si=-d\n        # perp basis\n        q1=e1-np.dot(e1,to_si)*to_si\n        if np.linalg.norm(q1)<1e-8: q1=e2-np.dot(e2,to_si)*to_si\n        q1=q1/np.linalg.norm(q1)\n        q2=np.cross(to_si,q1); q2=q2/np.linalg.norm(q2)\n        for h in range(3):\n            aa=2*pi*h/3\n            hd=(1/3)*d+sqrt(8/9)*(cos(aa)*q1+sin(aa)*q2)\n            add('H',cm+1.09*hd)\nwith open('answer.xyz','w') as f:\n    f.write(f'{len(atoms)}\\ntris(trimethylsilylcyclopentadienyl)yttrium anion, S=1/2\\n')\n    for e,p in zip(atoms,xyz): f.write(f'{e:2s} {p[0]: .8f} {p[1]: .8f} {p[2]: .8f}\\n')\nprint('atoms',len(atoms), {e:atoms.count(e) for e in set(atoms)})\nPY\npython /tmp/build.py\nhead -5 answer.xyz"
