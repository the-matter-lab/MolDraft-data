     "command": "cat > /tmp/build.py <<'PY'\nimport numpy as np, math\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom scipy.spatial.transform import Rotation\nsm='CC(C)(C)N1C(=S)NC=C1'\nm=Chem.AddHs(Chem.MolFromSmiles(sm))\nparams=AllChem.ETKDGv3(); params.randomSeed=27; params.useSmallRingTorsions=True\nassert AllChem.EmbedMolecule(m,params)==0\nAllChem.MMFFOptimizeMolecule(m, maxIters=500)\nprops=AllChem.MMFFGetMoleculeProperties(m)\nconf=m.GetConformer()\nxyz=np.array(conf.GetPositions())\n# Atoms in the ligand: S atom 6 and thione carbon atom 5; neighboring ring N index 7 sets plane basis.\nSidx=6; Cidx=5; Nidx=7\nS=xyz[Sidx]; C=xyz[Cidx]\ne1=(C-S); e1/=np.linalg.norm(e1)\nv=xyz[Nidx]-C\nv-=np.dot(v,e1)*e1\ne2=v/np.linalg.norm(v)\ne3=np.cross(e1,e2); e3/=np.linalg.norm(e3)\nsource=np.column_stack((e1,e2,e3))\n# Target thione sulfur centers form a trigonal array around In.\nIn=np.array([0.,0.,0.]); r=2.55\ncoords=[]; elems=[]; labels=[]\n# add indium first\ncoords.append(In); elems.append('In'); labels.append('In')\n# Three rotated ligand copies, ring planes approximately in the xy coordination plane.\nfor k in range(3):\n    phi=2*math.pi*k/3\n    u=np.array([math.cos(phi),math.sin(phi),0.])\n    tang=np.array([-math.sin(phi),math.cos(phi),0.])\n    d=0.22*u+math.sqrt(1-0.22**2)*tang # direction from sulfur to thione carbon\n    e1t=d\n    e2t=np.cross(np.array([0.,0.,1.]),d); e2t/=np.linalg.norm(e2t)\n    e3t=np.cross(e1t,e2t); e3t/=np.linalg.norm(e3t)\n    target=np.column_stack((e1t,e2t,e3t))\n    R=target@source.T\n    # locate S on In-S sphere\n    spos=r*u\n    transformed=(xyz-S)@R.T+spos\n    for i,(a,pt) in enumerate(zip(m.GetAtoms(),transformed)):\n        coords.append(pt); elems.append(a.GetSymbol()); labels.append(f'L{k+1}_{i}_{a.GetSymbol()}')\n# Add a tetrahedral [BH4]- counterion above the In-S3 plane, oriented one hydride toward In.\nB=np.array([0.,0.,3.25]); coords.append(B);elems.append('B');labels.append('B')\n# 4 tetrahedral directions: one down and the other 3 arranged above\nbhdirs=[np.array([0.,0.,-1.])]\nfor j in range(3):\n    a=2*math.pi*j/3\n    bhdirs.append(np.array([math.sqrt(8/9)*math.cos(a),math.sqrt(8/9)*math.sin(a),1/3]))\nfor i,v in enumerate(bhdirs):\n    coords.append(B+1.22*v); elems.append('H');labels.append(f'BH{i+1}')\ncoords=np.array(coords)\n# report nearest ligand-ligand distances (heavy atoms)\nstart=1; nlig=m.GetNumAtoms()\nfor k in range(3):\n    pass\n# nearest distances between different ligand heavy atoms\nmind=(100,None)\nfor i in range(1,1+3*nlig):\n    if elems[i] in ('H',): continue\n    li=labels[i].split('_')[0]\n    for j in range(i+1,1+3*nlig):\n        if elems[j]=='H' or labels[j].split('_')[0]==li: continue\n        dist=np.linalg.norm(coords[i]-coords[j])\n        if dist<mind[0]: mind=(dist,(labels[i],labels[j]))\nprint('atoms ligand',m.GetNumAtoms(),'total',len(coords),'min cross heavy',mind)\nwith open('answer.xyz','w') as f:\n    f.write(f'{len(coords)}\\n')\n    f.write('Tris(1-tert-butyl-imidazole-2-thione)indium(I) tetrahydroborate; Cartesian coordinates in angstrom\\n')\n    for e,p in zip(elems,coords): f.write(f'{e:2s} {p[0]: .6f} {p[1]: .6f} {p[2]: .6f}\\n')\nPY\npython /tmp/build.py\nhead -8 answer.xyz"
